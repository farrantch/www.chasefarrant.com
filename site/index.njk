---
description: Software, infrastructure, electronics, and things I build. Projects, experience, and ways to get in touch.
layout: layouts/terminal.njk
title: Chase Farrant
---
<a class="skip-link" href="#portfolio">Skip to portfolio</a>
<header class="topbar">
  <a class="wordmark" href="/" aria-label="Chase Farrant home"><span class="mark">cf&gt;</span><span class="wordmark-name">chasefarrant<span class="muted">.com</span></span></a>
  <span id="vm-status" class="sr-only" role="status"></span>
  <div id="open-link" class="guest-link" hidden><a id="guest-link" target="_blank" rel="noopener noreferrer">Open link ↗</a><button id="dismiss-link" type="button" aria-label="Dismiss link">×</button></div>
  <nav class="view-switch" aria-label="Choose your view">
    <button type="button" data-view="terminal" aria-pressed="true" hidden>Terminal</button>
    <a href="#portfolio" data-view="browse">Browse <span aria-hidden="true">↗</span></a>
  </nav>
</header>
<main>
  <section id="terminal-view" aria-label="Terminal" aria-busy="true" hidden>
    <h1 class="sr-only">Chase Farrant's terminal</h1>
    <div id="terminal-screen" role="region" aria-label="Terminal" aria-describedby="terminal-help"></div>
    <p id="terminal-help" class="sr-only">Tab completes. Up and Down recall commands. Ctrl+C stops a program. Shift+Tab leaves the terminal. Reloading or restarting discards your session.</p>
    <div id="boot-screen" class="boot-screen">
      <pre id="boot-log" class="boot-log">[ .. ] Starting…</pre>
      <span class="boot-cursor" aria-hidden="true">▌</span>
      <p id="boot-error" class="boot-error" role="alert" hidden></p>
    </div>
    <noscript><p>JavaScript is needed for the terminal. The full portfolio is available below.</p></noscript>
  </section>
  <section id="portfolio" class="portfolio" aria-labelledby="portfolio-title">
    <div class="portfolio-heading"><p class="eyebrow">Chase Farrant / Personal archive</p><h2 id="portfolio-title" tabindex="-1">Things I build.<br>Systems I make simpler.</h2><p>Software, infrastructure, electronics, and the occasional project made of lumber.</p></div>
    <nav class="directory-nav" aria-label="Portfolio sections"><a href="#projects">projects/</a><a href="#about">about/</a><a href="#career">career/</a><a href="#notes">notes/</a><a href="#contact">contact/</a></nav>
    <section id="projects" class="portfolio-section"><div class="section-heading"><h2>Projects</h2><span>{{ portfolio.projects | length }} records</span></div>
      <div class="project-list">{% for project in portfolio.projects %}
        <article class="project"><div class="project-meta"><span>{{ project.year }}</span><span>{{ project.categoryLabel }}</span></div><h3>{% if project.url %}<a href="{{ project.url }}">{{ project.title }} <span aria-hidden="true">↗</span></a>{% else %}{{ project.title }}{% endif %}</h3><p>{{ project.description }}</p>{% if project.materials %}<p class="materials">{{ project.materials | join(' / ') }}</p>{% endif %}</article>
      {% endfor %}</div>
    </section>
    <section id="about" class="portfolio-section"><div class="section-heading"><h2>About me</h2><span>about/</span></div><div class="about-copy">{{ portfolio.about }}</div><a href="/about/">Read more about me →</a></section>
    <section id="career" class="portfolio-section">
      <div class="section-heading"><h2>Career</h2><a href="{{ portfolio.resumeURL }}">Résumé (PDF) ↗</a></div>
      <p class="muted">{{ portfolio.career.note }}</p>
      {% for role in portfolio.career.roles %}
      <article class="role">
        <p class="muted">{{ role.dates }} · {{ role.location }}</p>
        <h3>{{ role.company }}</h3>
        <p class="role-title">{{ role.title }}</p>
        <p>{{ role.summary }}</p>
        {% if role.history %}<p class="muted">{{ role.history }}</p>{% endif %}
        {% for section in role.sections %}
        <div class="role-section">
          <h4>{{ section.heading }}</h4>
          {% if section.dates %}<p class="muted">{{ section.dates }}</p>{% endif %}
          <ul>{% for item in section.items %}<li>{{ item }}</li>{% endfor %}</ul>
        </div>
        {% endfor %}
        <p class="materials">{{ role.tools | join(' / ') }}</p>
      </article>
      {% endfor %}
    </section>
    <section id="notes" class="portfolio-section"><div class="section-heading"><h2>Notes</h2><span>Thinking out loud</span></div>{% for note in portfolio.notes %}<a class="note" href="{{ note.url }}"><span>{{ note.title }}</span><span aria-hidden="true">↗</span></a>{% endfor %}</section>
    <section id="contact" class="portfolio-section"><div class="section-heading"><h2>Contact</h2><span>Say hello.</span></div><p>Have a project that needs cloud, automation, or backend expertise? Let's talk.</p><div class="contact-links">{% for link in portfolio.links %}<a href="{{ link.url }}"{% if link.download %} download="{{ link.download }}"{% endif %}><span>{{ link.title }}</span><span>{{ link.label }} ↗</span></a>{% endfor %}</div></section>
  </section>
</main>
<footer class="site-footer">
  {% include "site-credit.njk" %}
</footer>
<script id="vm-config" type="application/json">{{ vm | jsonify | safe }}</script>
<script type="module" src="{{ vm.base }}vm-terminal.js"></script>
