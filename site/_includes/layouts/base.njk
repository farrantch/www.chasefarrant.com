---
title: Chase Farrant
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="description" content="{{ description or 'Projects, experiments, and practical notes by Chase Farrant.' }}">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{% if bodyClass == 'catalog-page' %}#040806{% else %}#eeebe2{% endif %}">

    {% if bodyClass == 'catalog-page' %}
    <link rel="preload" href="/fonts/jetbrains-mono-v18-cyrillic_cyrillic-ext_greek_latin_latin-ext_vietnamese-regular.woff2" as="font" type="font/woff2" crossorigin>
    {% else %}
    <link rel="preload" href="/fonts/noto-sans-v35-latin-regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/noto-sans-v35-latin-700.woff2" as="font" type="font/woff2" crossorigin>
    <link href="{{ '/css/photoswipe.css' | url | bust }}" rel="stylesheet">
    <link href="{{ '/css/prism.css' | url | bust }}" rel="stylesheet">
    <script defer src="https://unpkg.com/prismjs@v1.x/components/prism-core.min.js"></script>
    <script defer src="https://unpkg.com/prismjs@v1.x/plugins/autoloader/prism-autoloader.min.js"></script>
    {% endif %}
    <link href="{{ '/css/styles.css' | url | bust }}" rel="stylesheet">
    {% if bodyClass == 'catalog-page' %}<link href="{{ '/css/archive.css' | url | bust }}" rel="stylesheet">{% endif %}

    {% include "favicons.njk" %}
    <title>{% if title and title != 'Chase Farrant' %}{{ title }} — {% endif %}Chase Farrant</title>
  </head>
  <body class="{{ bodyClass or '' }}">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-mark" href="/" aria-label="Chase Farrant, return to terminal">
          <span class="site-mark__index">CF</span>
          <span class="site-mark__name">Chase Farrant</span>
        </a>

        <nav class="site-nav" aria-label="Primary navigation">
          <a href="/"{% if page.url == '/' %} aria-current="page"{% endif %}>Return to terminal</a>
          <a href="/blog/"{% if '/blog/' in page.url %} aria-current="page"{% endif %}>Notes</a>
          <a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
        </nav>
      </div>
    </header>

    <main id="main-content" class="site-main">
      <div class="{% if bodyClass == 'catalog-page' %}catalog-shell{% else %}prose{% endif %}">
        {{ content | safe }}
      </div>
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>An incomplete record, by design.</p>
        {% include "site-credit.njk" %}
        <p>
          <a href="https://github.com/farrantch" rel="me">GitHub</a>
          <span aria-hidden="true">/</span>
          <a href="mailto:hello@chasefarrant.com">Email</a>
        </p>
      </div>
    </footer>
  </body>
</html>
