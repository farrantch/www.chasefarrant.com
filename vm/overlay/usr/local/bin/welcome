#!/bin/sh
set -- $(stty size 2>/dev/null)
cols=${2:-80}
case "$cols" in ''|*[!0-9]*) cols=80 ;; esac
[ "$cols" -ge 20 ] || cols=80
width=$((cols - 4))
[ "$width" -le 76 ] || width=76
printf '\033[2J\033[H\n\033[32m'
cat <<'CF'
                          __________
                         /:::: ____/|
      ___________       /:::: /___|/    ____
     /::::::::::/|  ___/:::: /_______   \:::\
    /:::: _____/ / /:::::::::::::::/|    \:::\
   /:::: /     \/  \_/:::: ________|/     \:::\
   |::::|______     /:::: /|              /:::/|
   \::::::::::/|   /:::: / /             /:::/ /
    \________/ /  /_____/ /             /___/ /
     \_______\/   \_____\/              \___\/
CF
printf '\033[0m\n\033]777;art\007'
cat <<'INTRO' | fold -s -w "$width" | sed 's/^/  /'
Heyo, I'm Chase. I work in automation, cloud infrastructure, backend software development, and apparently vibecoding now. This is a collection of my work and side projects, from code and electronics to home renovation and tinkering around the farm.
INTRO
printf '\n  Start with \033[32mls\033[0m or \033[32mhelp\033[0m.\n\n'
