#!/bin/sh
chown guest:guest /dev/ttyS0
# Size the first greeting before the interactive resize channel takes over.
set -- $(sed -n 's/.*portfolio\.size=\([0-9][0-9]*\)x\([0-9][0-9]*\).*/\1 \2/p' /proc/cmdline)
if [ "$#" -eq 2 ] && [ "$1" -ge 2 ] && [ "$1" -le 500 ] && [ "$2" -ge 2 ] && [ "$2" -le 1000 ]; then
  stty -F /dev/ttyS0 rows "$1" cols "$2"
fi
exec /bin/su -l guest
